# Copiar a `.env` en la raíz si querés cambiar puertos/URLs.
# Los secretos NO van acá: cada servicio lee su propio .env
# (api-gastos/.env, bot-telegram/.env, servicio-ia/.env).

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=gestor_de_gastos_db

# Puertos publicados en el host
API_PORT=3000
IA_PORT=3002
WEB_PORT=8080
OLLAMA_PORT=11434

# URL que usa el navegador para hablar con la API.
# Se hornea en el build del front: si la cambiás, reconstruí front-web.
VITE_API_URL=http://localhost:3000

# Orígenes permitidos por CORS (el front en Docker usa 8080).
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173

# Logs
LOG_LEVEL=info

# Solo si usás el perfil de Ollama en Docker.
OLLAMA_HOST=http://ollama:11434
